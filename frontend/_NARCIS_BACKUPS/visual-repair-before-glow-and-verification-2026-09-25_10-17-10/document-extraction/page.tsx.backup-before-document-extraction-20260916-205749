/* =========================================================
   SMALL REUSABLE UI COMPONENTS
========================================================= */

function InfoCard({
  label,
  value,
  warning = false,
}: {
  label: string;
  value: string;
  warning?: boolean;
}) {
  return (
    <div className={styles.infoCard}>

      <span className={styles.infoLabel}>
        {label}
      </span>

      <strong className={styles.infoValue}>
        {value}
      </strong>

      {warning ? (
        <span className={styles.notFound}>
          NOT FOUND IN DOCUMENT
        </span>
      ) : (
        <span className={styles.extracted}>
          ● Extracted
        </span>
      )}

    </div>
  );
}


function WorkflowStep({
  number,
  title,
  description,
  state,
  last = false,
}: {
  number: string;
  title: string;
  description: string;
  state?: "complete" | "current";
  last?: boolean;
}) {
  return (
    <div
      className={`${styles.workflowStep} ${
        last ? styles.lastStep : ""
      }`}
    >

      <div
        className={`${styles.stepCircle} ${
          state === "current"
            ? styles.currentStep
            : state === "complete"
            ? styles.completeStep
            : ""
        }`}
      >
        {number}
      </div>

      <div className={styles.stepContent}>

        <div className={styles.stepTitleRow}>

          <strong>{title}</strong>

          {state === "complete" && (
            <span className={styles.completeLabel}>
              ✓ COMPLETE
            </span>
          )}

          {state === "current" && (
            <span className={styles.currentLabel}>
              CURRENT
            </span>
          )}

          {!state && (
            <span className={styles.nextLabel}>
              NEXT
            </span>
          )}

        </div>

        {description && (
          <p>{description}</p>
        )}

      </div>

    </div>
  );
