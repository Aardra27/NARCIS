.page {
  min-height: 100vh;
  display: flex;
  background: #f5f7fb;
  color: #172033;
  overflow: hidden;
}

/* ============================================================
   SIDEBAR
   ============================================================ */

.sidebar {
  width: 253px;
  min-width: 253px;
  height: 100vh;
  background: #071a3a;
  color: white;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  overflow-x: hidden;
  position: sticky;
  top: 0;
}

.sidebar::-webkit-scrollbar {
  width: 5px;
}

.sidebar::-webkit-scrollbar-thumb {
  background: rgba(255,255,255,.18);
  border-radius: 10px;
}

.sidebarTop {
  flex: 1 0 auto;
}

.logoArea {
  height: 88px;
  padding: 15px 20px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.logoMark {
  width: 44px;
  height: 44px;
  border: 2px solid #4b8dff;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5a9aff;
  font-size: 24px;
  font-weight: 800;
}

.logoText {
  font-size: 20px;
  font-weight: 800;
  letter-spacing: .5px;
}

.logoText span {
  display: block;
  margin-top: 2px;
  font-size: 7px;
  letter-spacing: 1.4px;
  color: #8fa4c7;
}

.navigation {
  padding: 18px 12px 6px;
}

.navItem {
  width: 100%;
  height: 46px;
  border: 0;
  background: transparent;
  color: #b9c7df;
  border-radius: 7px;
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 0 14px;
  font-size: 13px;
  text-align: left;
  cursor: pointer;
}

.navItem:hover {
  background: rgba(255,255,255,.06);
  color: white;
}

.navItem.active {
  background: #14366c;
  color: white;
}

.navIcon {
  width: 20px;
  text-align: center;
  font-size: 17px;
}

.sectionTitle {
  padding: 20px 25px 5px;
  color: #617ba8;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.5px;
}

.sidebarBottom {
  flex: 0 0 auto;
  padding: 12px;
}

.officer {
  min-height: 60px;
  border-top: 1px solid rgba(255,255,255,.08);
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 13px 6px;
}

.officerAvatar {
  width: 35px;
  height: 35px;
  border-radius: 50%;
  background: #274c83;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.officerInfo {
  flex: 1;
  min-width: 0;
}

.officerInfo strong,
.officerInfo span {
  display: block;
}

.officerInfo strong {
  font-size: 10px;
}

.officerInfo span {
  margin-top: 3px;
  font-size: 9px;
  color: #8296b9;
}

.logout {
  border: 0;
  background: transparent;
  color: #8498ba;
  cursor: pointer;
  font-size: 18px;
}

.secureSession {
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 7px;
  padding: 11px;
  display: flex;
  align-items: center;
  gap: 9px;
}

.secureSession strong,
.secureSession span {
  display: block;
}

.secureSession strong {
  font-size: 8px;
  letter-spacing: .7px;
}

.secureSession span {
  color: #7288ae;
  font-size: 8px;
  margin-top: 3px;
}

.secureDot {
  width: 7px;
  height: 7px;
  background: #39c879;
  border-radius: 50%;
}

/* ============================================================
   MAIN
   ============================================================ */

.main {
  flex: 1;
  min-width: 0;
  min-height: 100vh;
  overflow-y: auto;
  overflow-x: hidden;
}

.header {
  min-height: 116px;
  background: white;
  border-bottom: 1px solid #e4e8f0;
  padding: 27px 42px 23px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.breadcrumb {
  color: #70809c;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.1px;
}

.breadcrumb span {
  margin: 0 7px;
  color: #b2bac8;
}

.header h1 {
  margin: 8px 0 4px;
  font-size: 25px;
  font-weight: 750;
  color: #14213a;
}

.header p {
  margin: 0;
  color: #7b879d;
  font-size: 12px;
}

.headerStatus {
  white-space: nowrap;
  color: #62728e;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .5px;
}

.headerStatus span {
  display: inline-block;
  width: 7px;
  height: 7px;
  background: #35bf72;
  border-radius: 50%;
  margin-right: 7px;
}

/* ============================================================
   CONTENT
   ============================================================ */

.content {
  max-width: 1250px;
  margin: 0 auto;
  padding: 30px 42px 45px;
}

.progressCard {
  min-height: 76px;
  background: white;
  border: 1px solid #e3e8f1;
  border-radius: 9px;
  display: flex;
  align-items: center;
  padding: 12px 22px;
  margin-bottom: 22px;
}

.progressStep {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 170px;
}

.stepNumber {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #e7ebf2;
  color: #77839a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 800;
}

.progressStep strong,
.progressStep span {
  display: block;
}

.progressStep strong {
  font-size: 9px;
  letter-spacing: .4px;
  color: #69778f;
}

.progressStep span {
  font-size: 9px;
  color: #9ba5b5;
  margin-top: 3px;
}

.currentStep .stepNumber {
  background: #174b9b;
  color: white;
}

.currentStep strong {
  color: #174b9b;
}

.progressLine {
  flex: 1;
  height: 1px;
  background: #dfe4ed;
  margin: 0 12px;
}

.documentCard {
  background: white;
  border: 1px solid #e2e7ef;
  border-radius: 9px;
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 28px;
}

.documentIcon {
  width: 52px;
  height: 58px;
  border-radius: 7px;
  background: #edf3ff;
  color: #1754a5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 800;
}

.documentInfo {
  flex: 1;
}

.cardLabel {
  color: #7a879e;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 1.2px;
}

.documentInfo h2 {
  margin: 6px 0 4px;
  font-size: 15px;
  color: #17233b;
}

.documentInfo p {
  margin: 0;
  color: #8792a6;
  font-size: 10px;
}

.extractionComplete {
  color: #279a60;
  font-size: 9px;
  font-weight: 800;
  white-space: nowrap;
}

.extractionComplete span {
  display: inline-block;
  width: 7px;
  height: 7px;
  background: #2bbb72;
  border-radius: 50%;
  margin-right: 6px;
}

.sectionHeader {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin-bottom: 13px;
}

.sectionHeader h2 {
  margin: 5px 0 0;
  font-size: 18px;
  color: #17233b;
}

.fieldCount {
  color: #7d8ba4;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: .8px;
}

.fieldsGrid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.fieldCard {
  background: white;
  border: 1px solid #e2e7ef;
  border-radius: 7px;
  padding: 14px;
  min-height: 67px;
}

.fieldCard label {
  display: block;
  color: #8793a8;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: .5px;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.fieldValue {
  color: #1b2942;
  font-size: 12px;
  line-height: 1.4;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.missing {
  color: #a4adbc;
  font-weight: 400;
}

.warningCard {
  margin-top: 18px;
  background: #fff9ed;
  border: 1px solid #f0dfb7;
  border-radius: 8px;
  padding: 15px 17px;
}

.warningCard strong {
  color: #8a6419;
  font-size: 9px;
  letter-spacing: .6px;
}

.warningCard p {
  margin: 6px 0 10px;
  color: #8b7958;
  font-size: 10px;
}

.warningCard span {
  display: inline-block;
  padding: 5px 8px;
  margin: 2px 5px 2px 0;
  border-radius: 4px;
  background: #f5e8c9;
  color: #806126;
  font-size: 9px;
}

.actions {
  margin-top: 25px;
  display: flex;
  justify-content: space-between;
  gap: 15px;
}

.primaryButton,
.secondaryButton {
  min-height: 43px;
  padding: 0 20px;
  border-radius: 6px;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .4px;
  cursor: pointer;
}

.primaryButton {
  border: 0;
  background: #164a99;
  color: white;
}

.primaryButton:hover {
  background: #123e82;
}

.secondaryButton {
  background: white;
  border: 1px solid #d6dce6;
  color: #55657f;
}

.secondaryButton:hover {
  background: #f5f7fa;
}

.loadingCard,
.emptyCard {
  min-height: 320px;
  background: white;
  border: 1px solid #e2e7ef;
  border-radius: 9px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 35px;
}

.loadingCard h2,
.emptyCard h2 {
  margin: 18px 0 6px;
  color: #17233b;
  font-size: 18px;
}

.loadingCard p,
.emptyCard p {
  max-width: 430px;
  color: #8591a5;
  font-size: 11px;
  line-height: 1.6;
  margin: 0 0 20px;
}

.spinner {
  width: 30px;
  height: 30px;
  border: 3px solid #dce5f4;
  border-top-color: #1852a2;
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

.emptyIcon {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: #f7e9e9;
  color: #b64b4b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 1000px) {
  .fieldsGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .progressStep {
    min-width: 130px;
  }
}

@media (max-width: 760px) {
  .page {
    overflow: visible;
    display: block;
  }

  .sidebar {
    position: relative;
    width: 100%;
    min-width: 0;
    height: auto;
    max-height: none;
  }

  .sidebarBottom {
    padding-bottom: 15px;
  }

  .main {
    min-height: auto;
    overflow: visible;
  }

  .header {
    padding: 22px 20px;
    align-items: flex-start;
    flex-direction: column;
  }

  .content {
    padding: 20px;
  }

  .progressCard {
    overflow-x: auto;
  }

  .fieldsGrid {
    grid-template-columns: 1fr;
  }

  .documentCard {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .extractionComplete {
    width: 100%;
  }

  .actions {
    flex-direction: column-reverse;
  }

  .primaryButton,
  .secondaryButton {
    width: 100%;
  }
}
