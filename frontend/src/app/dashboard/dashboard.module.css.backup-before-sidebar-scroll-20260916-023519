.page {
  animation: dashboardEnter 1200ms cubic-bezier(.22, 1, .36, 1) both;
  will-change: opacity, transform, filter;
}

@keyframes dashboardEnter {
  0% {
    opacity: 0;
    transform: translateY(14px) scale(.997);
    filter: blur(4px);
  }

  30% {
    opacity: .35;
    transform: translateY(8px) scale(.998);
    filter: blur(2.5px);
  }

  65% {
    opacity: .82;
    transform: translateY(2px) scale(1);
    filter: blur(.8px);
  }

  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }
}
/* NARCIS PAGE TRANSITION */
.page {
  animation: dashboardEnter 650ms cubic-bezier(.22, 1, .36, 1) both;
  will-change: opacity, transform, filter;
}

.pageLeaving {
  animation: dashboardExit 420ms cubic-bezier(.65, 0, .35, 1) forwards;
  pointer-events: none;
}

@keyframes dashboardEnter {
  from {
    opacity: 0;
    transform: translateY(10px) scale(.998);
    filter: blur(2px);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }
}

@keyframes dashboardExit {
  from {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }

  to {
    opacity: 0;
    transform: translateY(-5px) scale(1.006);
    filter: blur(2px);
  }
}