  "pattern_name": "Intelligence Sources in Narcotics Investigations",

  "objective": "Provide structured knowledge regarding intelligence sources commonly used during narcotics investigations to support intelligence analysis, investigation planning and machine learning feature interpretation.",

  "intelligence_sources": [
