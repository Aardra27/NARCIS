  "intelligence_assessment": {
    "verification_principles": [
      "Corroborate intelligence using independent sources wherever possible.",
      "Document the origin of every intelligence input.",
      "Evaluate credibility before operational deployment.",
      "Maintain confidentiality of protected sources.",
      "Record intelligence handling in accordance with agency procedures."
    ]
